      "default_hotkey": "F3",
      "type": "local_code_cave_patch",
      "status": "supported",
      "enabled_by_default": false,
      "notes": "CT-style implementation: player pointer hook + health stat hook; only applies when [pPino_C+848] matches the current stat component."
