{
  "schema_version": 1,
  "game": {
    "id": "liesofp",
    "name": "Lies of P",
    "process_name": "LOP-Win64-Shipping.exe",
    "module_name": "LOP-Win64-Shipping.exe"
  },
  "trainer": {
    "version": "1.0.6",
    "minimum_loader_version": "1.0.0",
    "format": "declarative",
    "notes": "Single-player/offline package. Only God mode is exposed for this trainer build.",
    "source_table": "LOP-Win64-Shipping.CT.6.CT",
    "changelog": [
      "Removed combat/player-pointer hook to avoid breaking melee hit detection.",
      "God mode now learns and protects one health-stat pointer only."
    ],
    "conversion_notes": [
      "Remote package remains declarative. God mode execution is implemented locally in IMod.exe.",
      "No remote scripts, DLLs or Cheat Engine Auto Assembler code are executed."
    ]
  },
  "cheats": [
    {
      "id": "lop_god_mode",
      "name": "God mode",
      "description": "Keeps one learned local health stat high while active.",
      "category": "Player",
      "default_hotkey": "F3",
      "type": "local_code_cave_patch",
      "status": "supported",
      "enabled_by_default": false,
      "notes": "Single health-stat hook only. If the wrong target is learned, disable/enable God mode while out of combat."
    }
  ]
}
