    "changelog": [
      "Updated catalog from LOP-Win64-Shipping.CT.6.CT.",
      "Added V6 script entries as unsupported declarative cheats until local loader implementations exist."
    ],
    "conversion_notes": [
      "The source CT uses Auto Assembler scripts with aobscanmodule, allocations, registered symbols and pointer-derived values.",
      "This package intentionally does not include executable CT scripts, code caves or dynamic code.",
      "Entries are listed as unsupported until a local loader implementation exists for each cheat id."
    ]
  },
